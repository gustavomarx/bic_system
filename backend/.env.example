PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Firebase Admin SDK — service account do projeto Firebase (JSON em uma linha)
# Baixe em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_ADMIN_JSON={"type":"service_account","project_id":"..."}

# Firebase Client SDK — configurações públicas do projeto Firebase
# Encontre em: Firebase Console > Configurações do projeto > Seus apps > SDK config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Google Drive ──────────────────────────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
GOOGLE_DRIVE_INATIV_FOLDER_ID=your_inativ_folder_id_here
GOOGLE_DRIVE_DIST_FOLDER_ID=your_dist_cache_folder_id_here
GOOGLE_DRIVE_PALIATIVO_DOC_ID=your_paliativo_doc_id_here

# Local: caminho para o arquivo de service account
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Vercel: conteúdo JSON do service account (substitui o arquivo acima)
# Cole o conteúdo inteiro do service-account.json como string JSON em uma linha
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}

# ── ClickUp ───────────────────────────────────────────────────────────────────
CLICKUP_TOKEN=your_clickup_personal_api_token
CLICKUP_BIC_LIST_ID=901325453294
