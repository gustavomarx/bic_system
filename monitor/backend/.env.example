# ── BIC ────────────────────────────────────
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_CONNECT_STRING=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=XXXXX_bibic_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_no_drive
GOOGLE_DRIVE_LOG_FOLDER_ID=id_da_pasta_de_logs
GOOGLE_DRIVE_INATIV_FOLDER_ID=id_da_pasta_de_historico_inatividade
GOOGLE_DRIVE_DEPARA_FOLDER_ID=id_da_pasta_de_depara
GOOGLE_DRIVE_HISTORICO_FOLDER_ID=id_da_pasta_de_historico_vendas
GOOGLE_DRIVE_USUARIOS_FOLDER_ID=id_da_pasta_de_usuarios
GOOGLE_DRIVE_BATALHA_FOLDER_ID=id_da_pasta_de_batalha_naval

# ── M Dias Branco ───────────────────────────
MDIAS_DB_USER=seu_usuario
MDIAS_DB_PASSWORD=sua_senha
MDIAS_DB_CONNECT_STRING=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=XXXXX_bisellers_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

MDIAS_GOOGLE_DRIVE_COMPARATIVO_FOLDER_ID=id_da_pasta_comparativo_mdias
MDIAS_GOOGLE_DRIVE_BATALHA_FOLDER_ID=id_da_pasta_batalha_mdias
MDIAS_GOOGLE_DRIVE_HISTORICO_FOLDER_ID=id_da_pasta_historico_mdias

# ── Compartilhado ────────────────────────────
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

PORT=3001

# PostgreSQL — Organizations (BIC)
PG_HOST=ip_do_servidor
PG_PORT=5432
PG_DATABASE=organizations
PG_USER=seu_usuario_pg
PG_PASSWORD=sua_senha_pg

# ── Acesso pelo BIC System (Visão Geral → BIC Monitor, só admin) ──
# Mesmo valor do JWT_SECRET do bic_system (backend/.env)
SYSTEM_JWT_SECRET=
# Chave do agendamento diário (scripts/atualizar-todos.js envia em x-monitor-token)
MONITOR_TOKEN=
# Origens do system que podem embutir/chamar o monitor
SYSTEM_ORIGINS=https://bic-system.vercel.app,http://localhost:3004
# BigQuery (ADC do gcloud) — coordenadores
BIGQUERY_PROJECT_ID=flow-prod-303615
